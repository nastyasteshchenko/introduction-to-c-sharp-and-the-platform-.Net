<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>Developer</RootNamespace>
        <StartupObject>Developer.EmployeeMainProgram</StartupObject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CsvHelper" Version="33.0.1"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
        <PackageReference Include="MassTransit" Version="8.3.2" />
        <PackageReference Include="MassTransit.RabbitMQ" Version="8.3.2" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Resources/*" CopyToOutputDirectory="Always"/>
        <ProjectReference Include="../Common/Common.csproj"/>
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="../.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>
</Project>